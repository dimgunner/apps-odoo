<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_tree_se_jitsi_meet" model="ir.ui.view">
        <field name="name">se_jitsi_meet – view tree</field>
        <field name="model">jitsi.meet</field>
        <field name="arch" type="xml">
            <tree decoration-muted="closed==True">
                <field name="name"/>
                <field name="closed" invisible="1"/>
                <field name="date"/>
                <field name="date_delay" widget="float_time"/>
                <field name="participants" widget="many2many_tags"/>
                <field name="url_to_link" string="Share Link"/>
                <!--
                <button name="open" type="object" string="Join Meeting" class="oe_highlight"
                        attrs="{'invisible':[('closed','=',True)]}"/>
                -->
                <button name="open" type="object" string="Join Meeting" class="oe_highlight"
                        invisible="closed"/>
            </tree>
        </field>
    </record>

    <!-- Nueva vista de formulario servidores -->
    <record id="view_form_se_jitsi_meet" model="ir.ui.view">
        <field name="name">se_jitsi_meet – view form</field>
        <field name="model">jitsi.meet</field>
        <field name="arch" type="xml">
            <form string="Meeting">
                <header>
                    <field name="current_user" invisible="1"/>
                    <field name="create_uid" invisible="1"/>
                    <field name="closed" invisible="1"/>
                    <!--
                    <button name="open" type="object" string="Join Meeting" class="oe_highlight"
                            attrs="{'invisible':['|',('closed','=',True),('create_uid','=',False)]}"/>
                    <button name="action_close_meeting" string="Close Meeting" type="object" groups="base.group_user"
                            attrs="{'invisible':['|',('closed','=',True),('create_uid','=',False)]}"/>
                    <button name="action_reopen_meeting" string="Reopen Meeting" type="object" groups="base.group_user"
                            attrs="{'invisible':['|',('closed','!=',True),('create_uid','=',False)]}"/>
                    <button name="send_mail" type="object" string="Send Invitation by Mail" class="oe_highlight"
                            attrs="{'invisible':['|',('closed','=',True),('create_uid','=',False)]}"/>
                    -->
                    <button name="open" type="object" string="Join Meeting" class="oe_highlight"
                            invisible="closed or not create_uid"/>
                    <button name="action_close_meeting" string="Close Meeting" type="object" groups="base.group_user"
                            invisible="closed or not create_uid"/>
                    <button name="action_reopen_meeting" string="Reopen Meeting" type="object" groups="base.group_user"
                            invisible="not closed or not create_uid"/>
                    <button name="send_mail" type="object" string="Send Invitation by Mail" class="oe_highlight"
                            invisible="closed or not create_uid"/>
                </header>
                <sheet>
                    <h1>
                        <field name="name" placeholder="Meeting subject"/>
                    </h1>
                    <group name="info">
                        <group>
                            <field name="date"/>
                            <field name="date_formated"/>
                            <field name="date_delay" widget="float_time"/>
                            <field name="participants" widget="many2many_tags"/>
                            <field name="url_to_link" string="Share Link"/>
                            <field name="is_password_required"/>
                            <!--
                            <field name="user" attrs="{'invisible': [('is_password_required', '!=', True)]}"/>
                            <field name="password" attrs="{'invisible': [('is_password_required', '!=', True)]}"/>
                            -->
                            <field name="user" invisible="not is_password_required"/>
                            <field name="password" invisible="not is_password_required"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action avisos -->
    <!--
    <act_window
            id="action_meeting"
            name="Video Conferences"
            res_model="jitsi.meet"
            view_mode="tree,calendar,form"
            domain="[]"
    />
    -->
    <record id="action_meeting" model="ir.actions.act_window">
        <field name="name">Video Conferences</field>
        <field name="res_model">jitsi.meet</field>
        <field name="view_mode">tree,calendar,form</field>
        <field name="domain">[]</field>
    </record>

    <menuitem
            name="Video Conferences"
            id="menu_meeting"
            web_icon="se_jitsi_meet,static/description/web_cam.jpg"
            sequence="99"
            action="action_meeting"
    />
    <record model='ir.ui.menu' id='menu_meeting'>
        <field name="groups_id" eval="[(6,0,[ref('base.group_user')])]"/>
    </record>
</odoo>
