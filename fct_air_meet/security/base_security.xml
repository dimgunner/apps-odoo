<?xml version="1.0"?>
<odoo>
    <record model="ir.rule" id="se_jitsi_meet_rule">
        <field name="name">Air Meet: Only access meeting where user is participant</field>
        <field name="model_id" ref="fct_air_meet.model_air_meet"/>
        <field name="domain_force">[('participants', 'in', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="perm_write" eval="True"/>
    </record>
</odoo>
