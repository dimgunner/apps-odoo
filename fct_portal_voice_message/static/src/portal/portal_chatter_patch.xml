<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="portal.Chatter.Attachments" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_portal_chatter_attachment')]/a" position="replace">
            <t t-if="widget and attachment.mimetype === 'audio/mpeg'"
               class="o-mail-AttachmentCard d-flex rounded mb-1 me-1 mw-100 bg-100">
                <t t-set="voice_player_props" t-value='`{
                    "attachment": ${widget._attach_stringify(attachment)}
                }`'/>
                <owl-component name="fct_portal_voice_message.VoicePlayer" t-att-props='voice_player_props'/>
            </t>
            <t t-else="">$0</t>
        </xpath>
    </t>

    <t t-inherit="portal.Composer" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o_portal_chatter_composer_btn')]" position="before">
            <!--
            <div class="d-flex px-1">
                <button class="o_portal_chatter_attachment_btn btn fa fa-microphone border-0" type="button"
                        title="Send"/>
            </div>
            -->
            <!--
            <VoiceRecorder t-if="thread and thread.type !== 'chatter' and allowUpload"
                composer="props.composer"
                attachmentUploader="attachmentUploader"
                onchangeRecording.bind="() => this.state.recording = !this.state.recording"/>
            -->
            <t t-set="voice_recorder_props" t-value='`{
                "res_id": ${widget.options.res_id},
                "res_model": "${widget.options.res_model}",
                "token": "${widget.options.token}"
            }`'/>
            <owl-component name="fct_portal_voice_message.VoiceRecorderOWL" t-att-props='voice_recorder_props'/>
        </xpath>
    </t>
</templates>
